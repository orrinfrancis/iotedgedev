{
  "$schema-template": "4.0.0",
  "modulesContent": {
    "$edgeAgent": {
      "properties.desired": {
        "schemaVersion": "1.1",
        "runtime": {
          "type": "docker",
          "settings": {
            "minDockerVersion": "v1.25",
            "loggingOptions": "",
            "registryCredentials": {
              "privateAcr": {
                "username": "$CONTAINER_REGISTRY_USERNAME",
                "password": "$CONTAINER_REGISTRY_PASSWORD",
                "address": "$CONTAINER_REGISTRY_SERVER"
              }
            }
          }
        },
        "systemModules": {
          "edgeAgent": {
            "type": "docker",
            "settings": {
              "image": "mcr.microsoft.com/azureiotedge-agent:1.5",
              "createOptions": {}
            }
          },
          "edgeHub": {
            "type": "docker",
            "status": "running",
            "restartPolicy": "always",
            "settings": {
              "image": "mcr.microsoft.com/azureiotedge-hub:1.5",
              "createOptions": {
                "HostConfig": {
                  "PortBindings": {
                    "5671/tcp": [
                      {
                        "HostPort": "5671"
                      }
                    ],
                    "8883/tcp": [
                      {
                        "HostPort": "8883"
                      }
                    ],
                    "443/tcp": [
                      {
                        "HostPort": "443"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "modules": {
          "minewModule": {
            "version": "1.0",
            "type": "docker",
            "status": "running",
            "restartPolicy": "always",
            "settings": {
              "image": "${MODULES.minewModule}",
              "createOptions": {
                "ExposedPorts": {
                  "3001/tcp": {}
                },
                "HostConfig": {
                  "PortBindings": {
                    "3001/tcp": [
                      {
                        "HostPort": "3001"
                      }
                    ]
                  }
                }
              }
            }
          },
          "arubaModule": {
            "version": "1.0",
            "type": "docker",
            "status": "running",
            "restartPolicy": "always",
            "settings": {
              "image": "${MODULES.arubaModule}",
              "createOptions": {
                "ExposedPorts": {
                  "3002/tcp": {}
                },
                "HostConfig": {
                  "PortBindings": {
                    "3002/tcp": [
                      {
                        "HostPort": "3002"
                      }
                    ]
                  }
                }
              }
            }
          },
          "minewACC": {
            "env": {
              "PlanId": {
                "value": "stream-analytics-on-iot-edge"
              }
            },
            "restartPolicy": "always",
            "settings": {
              "image": "mcr.microsoft.com/azure-stream-analytics/azureiotedge:1.0.14"
            },
            "status": "running",
            "type": "docker",
            "version": "1.0.0.0"
          },
          "grafanaForwarder": {
            "version": "1.0",
            "type": "docker",
            "status": "running",
            "restartPolicy": "always",
            "settings": {
              "image": "${MODULES.grafanaForwarder}",
              "createOptions": {}
            }
          }
        }
      }
    },
    "$edgeHub": {
      "properties.desired": {
        "schemaVersion": "1.2",
        "routes": {
          "minewModuleToSA": "FROM /messages/modules/minewModule/outputs/ACC INTO BrokeredEndpoint(\"/modules/minewACC/inputs/ACC\")",
          "grafanaForwarderToLoki": "FROM /messages/modules/minewACC/outputs/* INTO BrokeredEndpoint(\"/modules/grafanaForwarder/inputs/forward\")"
        },
        "storeAndForwardConfiguration": {
          "timeToLiveSecs": 7200
        }
      }
    },
    "minewModule": {
      "properties.desired": {}
    },
    "minewACC": {
      "properties.desired": {
        "ASAJobInfo": "https://iotedgedevstorageaccount.blob.core.windows.net/asa-edge-eb2430b1-0a5c-4f39-9309-8237f05d0c91/ASAEdgeJobs/eb2430b1-0a5c-4f39-9309-8237f05d0c91/0638737920000000000.d72f5887-befd-4ee7-a59f-846517e43a52/ASAEdgeJobDefinition.zip?sv=2023-08-03&se=2028-01-30T10%3A33%3A18Z&sr=b&sp=r&sig=SyWxqTwPcBVKjarTw3f96pqvW%2FFMURtganLGufEB350%3D",
        "ASAJobResourceId": "/subscriptions/f13802b7-fde4-4dd8-ad05-16734900b3c0/resourceGroups/iotedgedev-rg/providers/Microsoft.StreamAnalytics/streamingjobs/minewACC",
        "ASAJobEtag": "c5bfd611-8ce5-4921-bcd0-16e3159299ea",
        "PublishTimestamp": "1/30/2025 10:33:24 AM"
      }
    }
  }
}
